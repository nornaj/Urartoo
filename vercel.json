{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/journal/:slug",
      "destination": "/journal-post"
    },
    {
      "source": "/product/:slug",
      "destination": "/product"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(html|js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).(webp|jpg|jpeg|png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
